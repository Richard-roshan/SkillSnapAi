rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile & All Nested Subcollections (roadmap, resume_analysis, activity_logs, ai_chats, ai_quizzes, ai_mock_interviews)
    // Users can read/write their own user document and any subcollection nested under /users/{userId}/...
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Courses Catalog Collection: Public read access for all, write access for authenticated users
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }
  }
}
